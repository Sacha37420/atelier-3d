# ── Secrets / config locale ──────────────────────────────────────────────────
.env
.keycloak-client-opts

# ── Python / Django ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
db.sqlite3
# Photos/maillages — servis par volume Docker externe, jamais versionnés
backend/media/

# ── Angular / Node ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.angular/
frontend/node_modules/

# ── Divers ───────────────────────────────────────────────────────────────────
*.log
.DS_Store

# ── Cache de build (scripts/clean2.sh + scripts/recompose_docker.sh) ────────
# Empreinte locale du dernier Dockerfile "lourd" buildé avec succès — .heavy-build
# (le marqueur lui-même) reste versionné, seule cette empreinte générée est locale.
.heavy-build.sha256
